#!/usr/bin/env bash
# Flash-Impulse setup — low-level engine CLI (power users).
# For a friendlier experience with backups, rollback and keyring secrets, use ./install.sh
cd "$(dirname "$0")" || exit 1
REPO_ROOT="$(pwd)"
export REPO_ROOT

# Load the engine as a library (env vars, core functions, distro + package helpers).
source ./sdata/lib/engine.sh

prevent_sudo_or_root
set -e

#####################################################################################
showhelp_global(){
printf "${STY_BOLD}${STY_CYAN}Flash-Impulse setup${STY_RST} — low-level engine.

Syntax:
  $0 <subcommand> [OPTIONS]...

Subcommands:
  install        (Re)Install/Update Flash-Impulse.
                 Note: To update to the latest, run \"git pull\" first (or use ./setup update).
  install-deps   Run install step \"1. Install dependencies\" only.
  install-setups Run install step \"2. Setup permissions/services etc\" only.
  install-files  Run install step \"3. Copying config files\" only.
  update         Pull latest and re-deploy config files (thin update).
  resetfirstrun  Reset firstrun state.
  uninstall      Uninstall Flash-Impulse.

  virtmon        (For dev only) Create virtual monitors for testing multi-monitors.
  checkdeps      (For dev only) Check whether pkgs exist in AUR or repos of Arch.

  help           Show this help message.

For each <subcommand>, use -h for details:
  $0 <subcommand> -h

${STY_FAINT}Tip: ./install.sh is the recommended front-end (component selection, backup/rollback,
API-key keyring, doctor). This CLI drives the same engine directly.${STY_RST}
"
}
case $1 in
  # Global help
  ""|help|--help|-h)showhelp_global;exit;;
  # Correct subcommand
  install|uninstall|update|resetfirstrun|checkdeps|virtmon)
    SUBCMD_NAME=$1
    SUBCMD_DIR=./sdata/subcmd-$1
    shift;;
  # Correct subcommand but not using ./sdata/subcmd-$1
  install-deps|install-setups|install-files)
    SUBCMD_NAME=$1
    SUBCMD_DIR=./sdata/subcmd-install
    shift;;
  # Wrong subcommand
  *)printf "${STY_RED}Unknown subcommand \"$1\".${STY_RST}\n";showhelp_global;exit 1;;
esac
#####################################################################################
if [[ -f "${SUBCMD_DIR}/options.sh" ]];
  then source "${SUBCMD_DIR}/options.sh"
fi
case ${SUBCMD_NAME} in
  install)
    engine_run_install
    ;;
  install-deps)
    engine_print_distro
    pause
    engine_begin_privileged
    [[ "${SKIP_ALLDEPS}" != true ]] && engine_install_deps
    ;;
  install-setups)
    engine_print_distro
    pause
    engine_begin_privileged
    [[ "${SKIP_ALLSETUPS}" != true ]] && engine_setup_services
    ;;
  install-files)
    engine_print_distro
    pause
    [[ "${SKIP_ALLFILES}" != true ]] && engine_deploy_files
    ;;
  *)
    source ${SUBCMD_DIR}/0.run.sh
    exit
    ;;
esac
